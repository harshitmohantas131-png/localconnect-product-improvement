generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())
}

model Issue {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  location    String
  date        DateTime
  createdAt   DateTime @default(now())
}

model MarketItem {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  price       Float
  status      String   @default("AVAILABLE")
  createdAt   DateTime @default(now())
}
